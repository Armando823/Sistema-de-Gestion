# Copia este archivo a .env y completa los valores. NUNCA subas .env a GitHub.

NODE_ENV=production
HOST=0.0.0.0
PORT=3001

# PostgreSQL compartido y autenticación web (obligatorios en producción).
DATABASE_URL=
# Genera valores aleatorios con al menos 32 bytes.
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Clave usada por las instalaciones Electron para notificar (mínimo 16 caracteres).
NOTIFY_API_KEY=

# --- Correo saliente (SMTP) ---
# Gmail: smtp.gmail.com, puerto 587, y una "contraseña de aplicación".
# Mejor aún: un servicio como Resend, SendGrid, Brevo o Amazon SES con tu dominio.
MAIL_FROM="Taller Digital <no-responder@tudominio.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# true = no envía nada, solo escribe en el log (útil para probar).
MAIL_DRY_RUN=false

# --- Datos del taller que aparecen en el correo ---
BUSINESS_NAME=Taller Digital
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=
BUSINESS_HOURS=
BUSINESS_RESPONSE_TIME=24 horas

# --- Seguridad ---
# true SOLO si hay un proxy inverso propio delante (nginx, Caddy...).
TRUST_PROXY=true
RATE_LIMIT_IP_PER_HOUR=30
RATE_LIMIT_EMAIL_PER_HOUR=5
# Solo si usas la versión web (no Electron): orígenes permitidos separados por coma.
ALLOWED_ORIGINS=

# URL de la app web: define este valor en el entorno de build del Static Site.
# VITE_API_URL=https://tu-api.onrender.com
