# Copia este archivo a .env y completa los valores. NUNCA subas .env a GitHub.

NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Base MySQL central (obligatoria) y autenticación web.
MYSQL_URL=mysql://taller:password@localhost:3306/taller_digital
# Opcional: certificado CA PEM del proveedor MySQL.
# MYSQL_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Genera valores aleatorios con al menos 32 bytes.
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Clave opcional para clientes internos del endpoint de correo (mínimo 16 caracteres).
NOTIFY_API_KEY=

# --- Correo saliente (SMTP) ---
# Gmail: smtp.gmail.com, puerto 587, y una "contraseña de aplicación".
# Mejor aún: un servicio como Resend, SendGrid, Brevo o Amazon SES con tu dominio.
MAIL_FROM="Taller Digital <no-responder@tudominio.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# true = no envía nada, solo escribe en el log (útil para probar).
MAIL_DRY_RUN=true

# --- WhatsApp Cloud API (Meta) ---
# El teléfono del remitente debe estar registrado en WhatsApp Business.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
# Ambas plantillas deben estar aprobadas y tener una variable {{1}} en el cuerpo.
WHATSAPP_OTP_TEMPLATE=customer_login_otp
WHATSAPP_ORDER_TEMPLATE=repair_order_code
WHATSAPP_TEMPLATE_LANGUAGE=es

# --- Datos del taller que aparecen en el correo ---
BUSINESS_NAME=Taller Digital
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=
BUSINESS_HOURS=
BUSINESS_RESPONSE_TIME=24 horas

# --- Seguridad ---
# true SOLO si hay un proxy inverso propio delante (nginx, Caddy...).
TRUST_PROXY=true
RATE_LIMIT_IP_PER_HOUR=30
RATE_LIMIT_EMAIL_PER_HOUR=5
# Orígenes permitidos separados por coma si la web se publica en otro dominio.
ALLOWED_ORIGINS=

# URL de la interfaz web servida por separado, si aplica.
# VITE_API_URL=https://tu-servidor.example.com
